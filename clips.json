    "text": "هاكونا ماتاتا",
    "character": "c1"
   },
   {
    "start": 28.5,
    "end": 29.72,
    "text": "اه دا شعارنا",
    "character": "c-1cf33811-1307-40af-a669-a21fb5d31a78"
   },
   {
    "start": 31.33,
    "end": 32.3,
    "text": "ايه شعورك نحونا؟",
    "character": "c1"
   },
   {
    "start": 32.54,
    "end": 34.36,
    "text": "هههههههه",
    "character": "c1"
   },
   {
    "start": 34.13,
    "end": 34.64,
    "text": "هههههه",
    "character": "c-1cf33811-1307-40af-a669-a21fb5d31a78"
   },
   {
    "start": 34.83,
    "end": 38.37,
    "text": "على فكرة الحكمة دي حتحل كل مشاكلك",
    "character": "c-1cf33811-1307-40af-a669-a21fb5d31a78"
   },
   {
    "start": 38.56,
    "end": 39.11,
    "text": "صح",
    "character": "c1"
   },
   {
    "start": 39.27,
    "end": 40.97,
    "text": "حتى اسأل بومبا وهو يقلك ليه",
    "character": "c1"
   },
   {
    "start": 42.19,
    "end": 44.56,
    "text": "لما كان خنزير صغنون",
    "character": "c1"
   },
   {
    "start": 45.09,
    "end": 48.84,
    "text": "لما كنت خنزير صغنون",
    "character": "c-1cf33811-1307-40af-a669-a21fb5d31a78"
   },
   {
    "start": 48.87,
    "end": 49.55,
    "text": "كلام جميل",
    "character": "c1"
   },
   {
    "start": 49.82,
    "end": 50.27,
    "text": "شكراً",
    "character": "c-1cf33811-1307-40af-a669-a21fb5d31a78"
   },
   {
    "start": 50.98,
    "end": 56.28,
    "text": "إكتشف ان ريحته سرها مستحيل يشمها المزكوم من على بعد ميل",
    "character": "c1"
   },
   {
    "start": 56.28,
    "end": 61.53,
    "text": "كنت أما أمشي لوحدي في سهول السند",
    "character": "c-1cf33811-1307-40af-a669-a21fb5d31a78"
   },
   {
    "start": 62.24,
    "end": 67.5,
    "text": "ألقى جميع من في الغابة فلسعوا عالهند!",
    "character": "c-1cf33811-1307-40af-a669-a21fb5d31a78"
   },
   {
    "start": 67.57,
    "end": 68.92,
    "text": "واتكسفت زاد ألمي!",
    "character": "c-1cf33811-1307-40af-a669-a21fb5d31a78"
   },
   {
    "start": 69.4,
    "end": 70.4,
    "text": "وتنكسف ليه ؟",
    "character": "c1"
   },
   {
    "start": 70.75,
    "end": 71.83,
    "text": "فكرت أغير اسمي!",
    "character": "c-1cf33811-1307-40af-a669-a21fb5d31a78"
   },
   {
    "start": 71.91,
    "end": 73.46,
    "text": "الإسم ذنبه ايه ؟",
    "character": "c1"
   },
   {
    "start": 73.46,
    "end": 74.7,
    "text": "هربت من الغابة",
    "character": "c-1cf33811-1307-40af-a669-a21fb5d31a78"
   },
   {
    "start": 74.83,
    "end": 76.16,
    "text": "عشان غشيم!",
    "character": "c1"
   },
   {
    "start": 76.04,
    "end": 77.33,
    "text": "وعشت في كأبه",
    "character": "c-1cf33811-1307-40af-a669-a21fb5d31a78"
   },
   {
    "start": 77.33,
    "end": 78.8,
    "text": "متعقدش الواد يا فصيح!",
    "character": "c1"
   },
   {
    "start": 78.8,
    "end": 79.52,
    "text": "بومبا: آه، أسف.",
    "character": "c-1cf33811-1307-40af-a669-a21fb5d31a78"
   },
   {
    "start": 80.45,
    "end": 82.41,
    "text": "هاكونا ماتاتا!",
    "character": "c1"
   },
   {
    "start": 82.89,
    "end": 85.72,
    "text": "حكمة نغمها لذيذ!",
    "character": "c1"
   },
   {
    "start": 86.02,
    "end": 87.77,
    "text": "هاكونا ماتاتا!",
    "character": "c1"
   },
   {
    "start": 88.38,
    "end": 91.24,
    "text": "إرمي الماضي اللي يغيظ",
    "character": "c1"
   },
   {
    "start": 95.97,
    "end": 97.33,
    "text": "آيوا، يا حلاوتك يا صاحبي!",
    "character": "c1"
   },
   {
    "start": 97.43,
