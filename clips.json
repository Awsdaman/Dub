    "character": "c1"
   },
   {
    "start": 22.43,
    "end": 24.42,
    "text": "(شهيق) كوابيس",
    "character": "c-4e982265-3628-46ba-b8c6-6df4a384a1d7"
   },
   {
    "start": 24.42,
    "end": 26.88,
